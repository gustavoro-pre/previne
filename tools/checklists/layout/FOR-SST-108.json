{"form": "FOR-SST-108", "rev": "000", "pagina": [210, 297], "marcas": [[8, 8], [197.0, 8], [8, 284.0], [197.0, 284.0]], "marca_mm": 5.0, "raio": 1.4, "itens": [{"n": 1, "t": "Equipamento com TAG/patrimônio legível e fita da cor do mês (inspeção periódica em dia)", "imp": true, "grupo": "Identificação e estado geral"}, {"n": 2, "t": "Carcaça, empunhaduras e manoplas sem trincas, quebras ou improvisos", "imp": true, "grupo": "Identificação e estado geral"}, {"n": 3, "t": "Cabo e plugue sem emendas, cortes, fios expostos ou isolação danificada", "imp": true, "grupo": "Alimentação elétrica"}, {"n": 4, "t": "Plugue padrão NBR 14136 compatível com a tomada (sem adaptação ou \"benjamim\")", "imp": true, "grupo": "Alimentação elétrica"}, {"n": 5, "t": "Tensão do equipamento identificada e igual à da tomada", "imp": true, "grupo": "Alimentação elétrica"}, {"n": 6, "t": "Ligado em circuito com DR (diferencial residual) ou em extensão com DR", "imp": true, "grupo": "Alimentação elétrica"}, {"n": 7, "t": "Extensão íntegra, com DR, e passada de forma aérea ou protegida contra pisoteio e veículos", "imp": false, "grupo": "Alimentação elétrica"}, {"n": 8, "t": "Mangueira e conexões sem rachaduras, rasgos, ressecamento ou vazamento", "imp": true, "grupo": "Ar comprimido (rompedor pneumático)"}, {"n": 9, "t": "Engates travando corretamente e com dispositivo anti-chicote", "imp": true, "grupo": "Ar comprimido (rompedor pneumático)"}, {"n": 10, "t": "Trava/retentor da ponteira ou talhadeira funcionando", "imp": true, "grupo": "Ponteira e travas"}, {"n": 11, "t": "Ponteira/talhadeira sem trincas, rebarbas (\"cogumelo\") ou partes quebradas", "imp": true, "grupo": "Ponteira e travas"}, {"n": 12, "t": "Punhos, molas e calços em bom estado; parafusos apertados", "imp": false, "grupo": "Ponteira e travas"}, {"n": 13, "t": "Gatilho/interruptor liga e desliga normalmente e não fica travado (\"homem-morto\" quando aplicável)", "imp": true, "grupo": "Funcionamento"}, {"n": 14, "t": "Funcionamento sem ruído, vibração, faísca ou aquecimento anormais", "imp": true, "grupo": "Funcionamento"}, {"n": 15, "t": "Aberturas de ventilação limpas e desobstruídas", "imp": false, "grupo": "Funcionamento"}, {"n": 16, "t": "APR/OS da atividade disponível e com os EPIs indicados", "imp": true, "grupo": "Condições de trabalho"}, {"n": 17, "t": "EPIs em uso conforme APR/OS (óculos, protetor facial quando indicado, protetor auricular, luvas)", "imp": true, "grupo": "Condições de trabalho"}, {"n": 18, "t": "Área isolada e sinalizada; sem pessoas na linha de projeção", "imp": false, "grupo": "Condições de trabalho"}, {"n": 19, "t": "Executante treinado e autorizado para o equipamento", "imp": true, "grupo": "Condições de trabalho"}], "bolhas": [{"item": 1, "dia": 0, "op": "C", "x": 117.929, "y": 81.361}, {"item": 1, "dia": 0, "op": "NC", "x": 121.786, "y": 81.361}, {"item": 1, "dia": 0, "op": "NA", "x": 125.643, "y": 81.361}, {"item": 1, "dia": 1, "op": "C", "x": 129.5, "y": 81.361}, {"item": 1, "dia": 1, "op": "NC", "x": 133.357, "y": 81.361}, {"item": 1, "dia": 1, "op": "NA", "x": 137.214, "y": 81.361}, {"item": 1, "dia": 2, "op": "C", "x": 141.071, "y": 81.361}, {"item": 1, "dia": 2, "op": "NC", "x": 144.929, "y": 81.361}, {"item": 1, "dia": 2, "op": "NA", "x": 148.786, "y": 81.361}, {"item": 1, "dia": 3, "op": "C", "x": 152.643, "y": 81.361}, {"item": 1, "dia": 3, "op": "NC", "x": 156.5, "y": 81.361}, {"item": 1, "dia": 3, "op": "NA", "x": 160.357, "y": 81.361}, {"item": 1, "dia": 4, "op": "C", "x": 164.214, "y": 81.361}, {"item": 1, "dia": 4, "op": "NC", "x": 168.071, "y": 81.361}, {"item": 1, "dia": 4, "op": "NA", "x": 171.929, "y": 81.361}, {"item": 1, "dia": 5, "op": "C", "x": 175.786, "y": 81.361}, {"item": 1, "dia": 5, "op": "NC", "x": 179.643, "y": 81.361}, {"item": 1, "dia": 5, "op": "NA", "x": 183.5, "y": 81.361}, {"item": 1, "dia": 6, "op": "C", "x": 187.357, "y": 81.361}, {"item": 1, "dia": 6, "op": "NC", "x": 191.214, "y": 81.361}, {"item": 1, "dia": 6, "op": 