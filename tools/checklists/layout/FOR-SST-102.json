{"form": "FOR-SST-102", "rev": "000", "pagina": [210, 297], "marcas": [[8, 8], [197.0, 8], [8, 284.0], [197.0, 284.0]], "marca_mm": 5.0, "raio": 1.4, "itens": [{"n": 1, "t": "Equipamento com TAG/patrimônio legível e fita da cor do mês (inspeção periódica em dia)", "imp": true, "grupo": "Identificação e estado geral"}, {"n": 2, "t": "Carcaça, empunhaduras e manoplas sem trincas, quebras ou improvisos", "imp": true, "grupo": "Identificação e estado geral"}, {"n": 3, "t": "Máquina fixada na bancada/piso, nivelada e estável", "imp": true, "grupo": "Identificação e estado geral"}, {"n": 4, "t": "Cabos e painel sem danos; carcaça aterrada", "imp": true, "grupo": "Alimentação elétrica"}, {"n": 5, "t": "Tensão identificada", "imp": false, "grupo": "Alimentação elétrica"}, {"n": 6, "t": "Botão de emergência acessível e funcionando (testar)", "imp": true, "grupo": "Dispositivos de segurança"}, {"n": 7, "t": "Proteção da correia/polias fechada e fixada", "imp": true, "grupo": "Dispositivos de segurança"}, {"n": 8, "t": "Proteção móvel do mandril/broca instalada (com intertravamento quando houver)", "imp": true, "grupo": "Dispositivos de segurança"}, {"n": 9, "t": "Chave de partida não liga sozinha após falta de energia (rearme manual)", "imp": false, "grupo": "Dispositivos de segurança"}, {"n": 10, "t": "Mandril, chave e broca em bom estado; chave retirada do mandril antes de ligar", "imp": true, "grupo": "Funcionamento"}, {"n": 11, "t": "Alavanca de avanço, trava da coluna e da mesa funcionando", "imp": false, "grupo": "Funcionamento"}, {"n": 12, "t": "Morsa/fixação da peça disponível e em uso (proibido segurar a peça com a mão)", "imp": true, "grupo": "Funcionamento"}, {"n": 13, "t": "Sem vibração ou ruído anormal", "imp": false, "grupo": "Funcionamento"}, {"n": 14, "t": "Área limpa, sem cavacos e óleo no piso", "imp": false, "grupo": "Funcionamento"}, {"n": 15, "t": "APR/OS da atividade disponível e com os EPIs indicados", "imp": true, "grupo": "Condições de trabalho"}, {"n": 16, "t": "EPIs em uso conforme APR/OS (óculos, protetor facial quando indicado, protetor auricular, luvas)", "imp": true, "grupo": "Condições de trabalho"}, {"n": 17, "t": "Área isolada e sinalizada; sem pessoas na linha de projeção", "imp": false, "grupo": "Condições de trabalho"}, {"n": 18, "t": "Executante treinado e autorizado para o equipamento", "imp": true, "grupo": "Condições de trabalho"}], "bolhas": [{"item": 1, "dia": 0, "op": "C", "x": 117.929, "y": 81.669}, {"item": 1, "dia": 0, "op": "NC", "x": 121.786, "y": 81.669}, {"item": 1, "dia": 0, "op": "NA", "x": 125.643, "y": 81.669}, {"item": 1, "dia": 1, "op": "C", "x": 129.5, "y": 81.669}, {"item": 1, "dia": 1, "op": "NC", "x": 133.357, "y": 81.669}, {"item": 1, "dia": 1, "op": "NA", "x": 137.214, "y": 81.669}, {"item": 1, "dia": 2, "op": "C", "x": 141.071, "y": 81.669}, {"item": 1, "dia": 2, "op": "NC", "x": 144.929, "y": 81.669}, {"item": 1, "dia": 2, "op": "NA", "x": 148.786, "y": 81.669}, {"item": 1, "dia": 3, "op": "C", "x": 152.643, "y": 81.669}, {"item": 1, "dia": 3, "op": "NC", "x": 156.5, "y": 81.669}, {"item": 1, "dia": 3, "op": "NA", "x": 160.357, "y": 81.669}, {"item": 1, "dia": 4, "op": "C", "x": 164.214, "y": 81.669}, {"item": 1, "dia": 4, "op": "NC", "x": 168.071, "y": 81.669}, {"item": 1, "dia": 4, "op": "NA", "x": 171.929, "y": 81.669}, {"item": 1, "dia": 5, "op": "C", "x": 175.786, "y": 81.669}, {"item": 1, "dia": 5, "op": "NC", "x": 179.643, "y": 81.669}, {"item": 1, "dia": 5, "op": "NA", "x": 183.5, "y": 81.669}, {"item": 1, "dia": 6, "op": "C", "x": 187.357, "y": 81.669}, {"item": 1, "dia": 6, "op": "NC", "x": 191.214, "y": 81.669}, {"item": 1, "dia": 6, "op": "NA", "x": 195.071, "y": 81.669}, {"item": 2, "dia": 0, "op": "C", "x": 117.929, "y": 88.808}, {"item": 2, "dia": 0, "op": "NC", "x": 121.786, "y": 88.808}, {"item": 2, "dia": 0, "op": "NA", "x": 125.643, "y": 88.808}, {"item": 2, "dia": 1, "op": "C", "x": 129.5, "y": 88.808}, {"item": 2, "dia": 1, "op": "NC", "x": 133.357, "y