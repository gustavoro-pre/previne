{"form": "FOR-SST-105", "rev": "000", "pagina": [210, 297], "marcas": [[8, 8], [197.0, 8], [8, 284.0], [197.0, 284.0]], "marca_mm": 5.0, "raio": 1.4, "itens": [{"n": 1, "t": "Equipamento com TAG/patrimônio legível e fita da cor do mês (inspeção periódica em dia)", "imp": true, "grupo": "Identificação e estado geral"}, {"n": 2, "t": "Carcaça, empunhaduras e manoplas sem trincas, quebras ou improvisos", "imp": true, "grupo": "Identificação e estado geral"}, {"n": 3, "t": "Instalado em bancada ou base firme, piso nivelado", "imp": true, "grupo": "Identificação e estado geral"}, {"n": 4, "t": "Cabo e plugue sem emendas, cortes, fios expostos ou isolação danificada", "imp": true, "grupo": "Alimentação elétrica"}, {"n": 5, "t": "Plugue padrão NBR 14136 compatível com a tomada (sem adaptação ou \"benjamim\")", "imp": true, "grupo": "Alimentação elétrica"}, {"n": 6, "t": "Tensão do equipamento identificada e igual à da tomada", "imp": true, "grupo": "Alimentação elétrica"}, {"n": 7, "t": "Ligado em circuito com DR (diferencial residual) ou em extensão com DR", "imp": true, "grupo": "Alimentação elétrica"}, {"n": 8, "t": "Coifa protetora do disco instalada e funcionando (retorno automático)", "imp": true, "grupo": "Disco e proteções"}, {"n": 9, "t": "Disco de corte adequado, dentro da validade, sem trinca; RPM compatível", "imp": true, "grupo": "Disco e proteções"}, {"n": 10, "t": "Morsa de fixação da peça íntegra e em uso", "imp": true, "grupo": "Disco e proteções"}, {"n": 11, "t": "Botão de emergência/desligamento acessível e funcionando", "imp": true, "grupo": "Disco e proteções"}, {"n": 12, "t": "Alavanca de descida do disco com retorno por mola", "imp": false, "grupo": "Disco e proteções"}, {"n": 13, "t": "Funcionamento sem ruído, vibração, faísca ou aquecimento anormais", "imp": true, "grupo": "Funcionamento"}, {"n": 14, "t": "Aberturas de ventilação limpas e desobstruídas", "imp": false, "grupo": "Funcionamento"}, {"n": 15, "t": "APR/OS da atividade disponível e com os EPIs indicados", "imp": true, "grupo": "Condições de trabalho"}, {"n": 16, "t": "EPIs em uso conforme APR/OS (óculos, protetor facial quando indicado, protetor auricular, luvas)", "imp": true, "grupo": "Condições de trabalho"}, {"n": 17, "t": "Área isolada e sinalizada; sem pessoas na linha de projeção", "imp": false, "grupo": "Condições de trabalho"}, {"n": 18, "t": "Executante treinado e autorizado para o equipamento", "imp": true, "grupo": "Condições de trabalho"}, {"n": 19, "t": "Permissão para trabalho a quente emitida (quando exigida pela área)", "imp": true, "grupo": "Trabalho a quente"}, {"n": 20, "t": "Materiais combustíveis removidos ou protegidos (raio mínimo de 10 m ou barreira/manta)", "imp": true, "grupo": "Trabalho a quente"}, {"n": 21, "t": "Extintor adequado (PQS/CO2) a até 5 m e carregado (lacre e manômetro na faixa verde)", "imp": true, "grupo": "Trabalho a quente"}, {"n": 22, "t": "Observador de incêndio designado quando exigido", "imp": false, "grupo": "Trabalho a quente"}], "bolhas": [{"item": 1, "dia": 0, "op": "C", "x": 117.929, "y": 80.684}, {"item": 1, "dia": 0, "op": "NC", "x": 121.786, "y": 80.684}, {"item": 1, "dia": 0, "op": "NA", "x": 125.643, "y": 80.684}, {"item": 1, "dia": 1, "op": "C", "x": 129.5, "y": 80.684}, {"item": 1, "dia": 1, "op": "NC", "x": 133.357, "y": 80.684}, {"item": 1, "dia": 1, "op": "NA", "x": 137.214, "y": 80.684}, {"item": 1, "dia": 2, "op": "C", "x": 141.071, "y": 80.684}, {"item": 1, "dia": 2, "op": "NC", "x": 144.929, "y": 80.684}, {"item": 1, "dia": 2, "op": "NA", "x": 148.786, "y": 80.684}, {"item": 1, "dia": 3, "op": "C", "x": 152.643, "y": 80.684}, {"item": 1, "dia": 3, "op": "NC", "x": 156.5, "y": 80.684}, {"item": 1, "dia": 3, "op": "NA", "x": 160.357, "y": 80.684}, {"item": 1, "dia": 4, "op": "C", "x": 164.214, "y": 80.684}, {"item": 1, "dia": 4, "op": "NC", "x": 168.071, "y": 80.684}, {"item": 1, "dia": 4, "op": "NA", "x": 171.929, "y": 80.684}, {"item": 1, "dia": 5, "op": "C", "x": 175.786, "y": 80.