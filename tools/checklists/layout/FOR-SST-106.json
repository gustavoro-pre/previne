{"form": "FOR-SST-106", "rev": "000", "pagina": [210, 297], "marcas": [[8, 8], [197.0, 8], [8, 284.0], [197.0, 284.0]], "marca_mm": 5.0, "raio": 1.4, "itens": [{"n": 1, "t": "Equipamento com TAG/patrimônio legível e fita da cor do mês (inspeção periódica em dia)", "imp": true, "grupo": "Identificação e estado geral"}, {"n": 2, "t": "Carcaça, empunhaduras e manoplas sem trincas, quebras ou improvisos", "imp": true, "grupo": "Identificação e estado geral"}, {"n": 3, "t": "Cabo e plugue sem emendas, cortes, fios expostos ou isolação danificada", "imp": true, "grupo": "Alimentação elétrica"}, {"n": 4, "t": "Plugue padrão NBR 14136 compatível com a tomada (sem adaptação ou \"benjamim\")", "imp": true, "grupo": "Alimentação elétrica"}, {"n": 5, "t": "Tensão do equipamento identificada e igual à da tomada", "imp": true, "grupo": "Alimentação elétrica"}, {"n": 6, "t": "Ligado em circuito com DR (diferencial residual) ou em extensão com DR", "imp": true, "grupo": "Alimentação elétrica"}, {"n": 7, "t": "Extensão íntegra, com DR, e passada de forma aérea ou protegida contra pisoteio e veículos", "imp": false, "grupo": "Alimentação elétrica"}, {"n": 8, "t": "Coifa de proteção instalada, íntegra e bem fixada", "imp": true, "grupo": "Disco e proteções"}, {"n": 9, "t": "Disco compatível com o material, sem trinca ou dente quebrado; RPM compatível", "imp": true, "grupo": "Disco e proteções"}, {"n": 10, "t": "Porca e flange do disco apertados com chave própria", "imp": true, "grupo": "Disco e proteções"}, {"n": 11, "t": "Corte a úmido ou com aspiração quando houver poeira (sílica)", "imp": false, "grupo": "Disco e proteções"}, {"n": 12, "t": "Gatilho/interruptor liga e desliga normalmente e não fica travado (\"homem-morto\" quando aplicável)", "imp": true, "grupo": "Funcionamento"}, {"n": 13, "t": "Funcionamento sem ruído, vibração, faísca ou aquecimento anormais", "imp": true, "grupo": "Funcionamento"}, {"n": 14, "t": "Aberturas de ventilação limpas e desobstruídas", "imp": false, 