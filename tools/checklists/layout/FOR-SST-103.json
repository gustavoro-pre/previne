{"form": "FOR-SST-103", "rev": "000", "pagina": [210, 297], "marcas": [[8, 8], [197.0, 8], [8, 284.0], [197.0, 284.0]], "marca_mm": 5.0, "raio": 1.4, "itens": [{"n": 1, "t": "Equipamento com TAG/patrimônio legível e fita da cor do mês (inspeção periódica em dia)", "imp": true, "grupo": "Identificação e estado geral"}, {"n": 2, "t": "Carcaça, empunhaduras e manoplas sem trincas, quebras ou improvisos", "imp": true, "grupo": "Identificação e estado geral"}, {"n": 3, "t": "Cabo e plugue sem emendas, cortes, fios expostos ou isolação danificada", "imp": true, "grupo": "Alimentação elétrica"}, {"n": 4, "t": "Plugue padrão NBR 14136 compatível com a tomada (sem adaptação ou \"benjamim\")", "imp": true, "grupo": "Alimentação elétrica"}, {"n": 5, "t": "Tensão do equipamento identificada e igual à da tomada", "imp": true, "grupo": "Alimentação elétrica"}, {"n": 6, "t": "Ligado em circuito com DR (diferencial residual) ou em extensão com DR", "imp": true, "grupo": "Alimentação elétrica"}, {"n": 7, "t": "Extensão íntegra, com DR, e passada de forma aérea ou protegida contra pisoteio e veículos", "imp": false, "grupo": "Alimentação elétrica"}, {"n": 8, "t": "Bateria original/compatível (mesma marca e tensão), sem trincas, inchaço ou vazamento", "imp": true, "grupo": "Equipamento a bateria (se aplicável)"}, {"n": 9, "t": "Bateria bem encaixada e travada; contatos limpos", "imp": false, "grupo": "Equipamento a bateria (se aplicável)"}, {"n": 10, "t": "Carregador íntegro, usado em local seco e ventilado", "imp": false, "grupo": "Equipamento a bateria (se aplicável)"}, {"n": 11, "t": "Coifa de proteção instalada e bem fixada (desbaste: abertura máx. 180°; corte: 150°)", "imp": true, "grupo": "Disco e proteções"}, {"n": 12, "t": "Disco adequado ao serviço (corte ou desbaste), dentro da validade, sem trinca ou umidade", "imp": true, "grupo": "Disco e proteções"}, {"n": 13, "t": "RPM máxima do disco maior ou igual à RPM do equipamento", "imp": true, "grupo": "Disco e proteções"}, {"n": 14, "t": "Flange e porca corretas e apertadas com a chave própria", "imp": true, "grupo": "Disco e proteções"}, {"n": 15, "t": "Empunhadura lateral instalada", "imp": true, "grupo": "Disco e proteções"}, {"n": 16, "t": "Gatilho/interruptor liga e desliga normalmente e não fica travado (\"homem-morto\" quando aplicável)", "imp": true, "grupo": "Funcionamento"}, {"n": 17, "t": "Funcionamento sem ruído, vibração, faísca ou aquecimento anormais", "imp": true, "grupo": "Funcionamento"}, {"n": 18, "t": "Aberturas de ventilação limpas e desobstruídas", "imp": false, "grupo": "Funcionamento"}, {"n": 19, "t": "APR/OS da atividade disponível e com os EPIs indicados", "imp": true, "grupo": "Condições de trabalho"}, {"n": 20, "t": "EPIs em uso conforme APR/OS (óculos, protetor facial quando indicado, protetor auricular, luvas)", "imp": true, "grupo": "Condições de trabalho"}, {"n": 21, "t": "Área isolada e sinalizada; sem pessoas na linha de projeção", "imp": false, "grupo": "Condições de trabalho"}, {"n": 22, "t": "Executante treinado e autorizado para o equipamento", "imp": true, "grupo": "Condições de trabalho"}, {"n": 23, "t": "Permissão para trabalho a quente emitida (quando exigida pela área)", "imp": true, "grupo": "Trabalho a quente"}, {"n": 24, "t": "Materiais combustíveis removidos ou protegidos (raio mínimo de 10 m ou barreira/manta)", "imp": true, "grupo": "Trabalho a quente"}, {"n": 25, "t": "Extintor adequado (PQS/CO2) a até 5 m e carregado (lacre e manômetro na faixa verde)", "imp": true, "grupo": "Trabalho a quente"}, {"n": 26, "t": "Observador de incêndio designado quando exigido", "imp": false, "grupo": "Trabalho a quente"}], "bolhas": [{"item": 1, "dia": 0, "op": "C", "x": 117.929, "y": 87.01}, {"item": 1, "dia": 0, "op": "NC", "x": 121.786, "y": 87.01}, {"item": 1, "dia": 0, "op": "NA", "x": 125.643, "y": 87.01}, {"item": 1, "dia": 1, "op": "C", "x": 129.5, "y": 87.01}, {"item": 1, "dia": 1, "op": "NC", "x": 133.357, "y": 87.01}, {"item": 1, "dia": 1, "op"