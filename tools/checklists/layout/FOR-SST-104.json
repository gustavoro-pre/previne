{"form": "FOR-SST-104", "rev": "000", "pagina": [210, 297], "marcas": [[8, 8], [197.0, 8], [8, 284.0], [197.0, 284.0]], "marca_mm": 5.0, "raio": 1.4, "itens": [{"n": 1, "t": "Equipamento com TAG/patrimônio legível e fita da cor do mês (inspeção periódica em dia)", "imp": true, "grupo": "Identificação e estado geral"}, {"n": 2, "t": "Carcaça, empunhaduras e manoplas sem trincas, quebras ou improvisos", "imp": true, "grupo": "Identificação e estado geral"}, {"n": 3, "t": "Etiqueta com tensão, RPM e potência legível", "imp": false, "grupo": "Identificação e estado geral"}, {"n": 4, "t": "Cabo e plugue sem emendas, cortes, fios expostos ou isolação danificada", "imp": true, "grupo": "Alimentação elétrica"}, {"n": 5, "t": "Plugue padrão NBR 14136 compatível com a tomada (sem adaptação ou \"benjamim\")", "imp": true, "grupo": "Alimentação elétrica"}, {"n": 6, "t": "Tensão do equipamento identificada e igual à da tomada", "imp": true, "grupo": "Alimentação elétrica"}, {"n": 7, "t": "Ligado em circuito com DR (diferencial residual) ou em extensão com DR", "imp": true, "grupo": "Alimentação elétrica"}, {"n": 8, "t": "Extensão íntegra, com DR, e passada de forma aérea ou protegida contra pisoteio e veículos", "imp": false, "grupo": "Alimentação elétrica"}, {"n": 9, "t": "Mangueira e engates sem rachaduras, vazamentos; com dispositivo anti-chicote", "imp": true, "grupo": "Ar comprimido (retífica pneumática)"}, {"n": 10, "t": "Pressão de trabalho conforme fabricante", "imp": false, "grupo": "Ar comprimido (retífica pneumática)"}, {"n": 11, "t": "Pinça correta para a haste e bem apertada com a chave própria", "imp": true, "grupo": "Ponta montada e fixação"}, {"n": 12, "t": "Ponta/rebolo sem trinca, quebra ou desgaste excessivo; RPM compatível", "imp": true, "grupo": "Ponta montada e fixação"}, {"n": 13, "t": "Escovas de carvão e tampas fixas", "imp": false, "grupo": "Ponta montada e fixação"}, {"n": 14, "t": "Gatilho/interruptor liga e desliga normalmente e não fica travado (\"homem-morto\" quando aplicável)", "imp": true, "grupo": "Funcionamento"}, {"n": 15, "t": "Funcionamento sem ruído, vibração, faísca ou aquecimento anormais", "imp": true, "grupo": "Funcionamento"}, {"n": 16, "t": "Aberturas de ventilação limpas e desobstruídas", "imp": false, "grupo": "Funcionamento"}, {"n": 17, "t": "Controle de velocidade (se houver) funcionando", "imp": false, "grupo": "Funcionamento"}, {"n": 18, "t": "APR/OS da atividade disponível e com os EPIs indicados", "imp": true, "grupo": "Condições de trabalho"}, {"n": 19, "t": "EPIs em uso conforme APR/OS (óculos, protetor facial quando indicado, protetor auricular, luvas)", "imp": true, "grupo": "Condições de trabalho"}, {"n": 20, "t": "Área isolada e sinalizada; sem pessoas na linha de projeção", "imp": false, "grupo": "Condições de trabalho"}, {"n": 21, "t": "Executante treinado e autorizado para o equipamento", "imp": true, "grupo": "Condições de trabalho"}], "bolhas": [{"item": 1, "dia": 0, "op": "C", "x": 117.929, "y": 80.826}, {"item": 1, "dia": 0, "op": "NC", "x": 121.786, "y": 80.826}, {"item": 1, "dia": 0, "op": "NA", "x": 125.643, "y": 80.826}, {"item": 1, "dia": 1, "op": "C", "x": 129.5, "y": 80.826}, {"item": 1, "dia": 1, "op": "NC", "x": 133.357, "y": 80.826}, {"item": 1, "dia": 1, "op": "NA", "x": 137.214, "y": 80.826}, {"item": 1, "dia": 2, "op": "C", "x": 141.071, "y": 80.826}, {"item": 1, "dia": 2, "op": "NC", "x": 144.929, "y": 80.826}, {"item": 1, "dia": 2, "op": "NA", "x": 148.786, "y": 80.826}, {"item": 1, "dia": 3, "op": "C", "x": 152.643, "y": 80.826}, {"item": 1, "dia": 3, "op": "NC", "x": 156.5, "y": 80.826}, {"item": 1, "dia": 3, "op": "NA", "x": 160.357, "y": 80.826}, {"item": 1, "dia": 4, "op": "C", "x": 164.214, "y": 80.826}, {"item": 1, "dia": 4, "op": "NC", "x": 168.071, "y": 80.826}, {"item": 1, "dia": 4, "op": "NA", "x": 171.929, "y": 80.826}, {"item": 1, "dia": 5, "op": "C", "x": 175.786, "y": 80.826}, {"item": 1, "dia": 5, "op": "NC", "x": 179.643, "y": 80.826}, {"item