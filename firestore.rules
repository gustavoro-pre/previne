rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function logado() { return request.auth != null; }
    function perfil() { return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data; }
    function ativo() { return logado() && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) && perfil().ativo == true; }
    function tem(papeis) { return ativo() && perfil().papel in papeis; }
    // equipe = qualquer usuário ativo que não seja funcionário do portal do aluno
    function equipe() { return ativo() && perfil().papel != 'funcionario'; }
    // aluno = funcionário que entra pelo portal do aluno (só vê o que é dele)
    function aluno() { return ativo() && perfil().papel == 'funcionario'; }
    function meuFunc() { return perfil().funcionarioId; }
    // perfil no módulo Treinamentos (sem perfil definido: Gerente vira gestor, TST e RH continuam)
    function mt() { return perfil().get('modulos', {}).get('treinamentos', ''); }
    // perfil no módulo Alocação em OM (sem perfil definido: Gerente lança)
    function ma() { return perfil().get('modulos', {}).get('alocacao', ''); }
    function aloc(ps) { return equipe() && (perfil().papel in ['admin', 'gestao'] || ma() in ps || (ma() == '' && perfil().papel == 'gerente' && 'adm' in ps)); }
    // perfil no módulo Admissão (sem perfil definido: RH e Gerente são RH)
    function mad() { return perfil().get('modulos', {}).get('admissao', ''); }
    function admi(ps) { return equipe() && (perfil().papel in ['admin', 'gestao'] || mad() in ps || (mad() == '' && perfil().papel in ['rh', 'gerente'] && 'rh' in ps)); }
    function trein(ps) { return equipe() && (perfil().papel in ['admin', 'gestao'] || mt() in ps || (mt() == '' && ((perfil().papel == 'gerente' && 'gestor' in ps) || perfil().papel in ps))); }

    // configuração inicial (primeiro administrador): só pode ser criada uma vez
    match /config/setup {
      allow read: if true;
      allow create: if logado() && request.resource.data.adminUid == request.auth.uid;
    }
    match /config/empresa { allow read: if ativo(); allow write: if tem(['admin', 'gestao']); }
    // nome da empresa para a página do candidato (sem login)
    match /config/publico { allow read: if true; allow write: if tem(['admin', 'gestao']) || admi(['rh']); }
    match /config/admissao { allow read: if admi(['rh', 'consulta']); allow write: if admi(['rh']); }
    match /config/regras  { allow read: if equipe(); allow write: if tem(['admin', 'gerente', 'gestao']); }

    match /usuarios/{uid} {
      allow read: if equipe() || (logado() && request.auth.uid == uid);
      // Gestão cadastra e edita usuários, mas nunca com perfil Administrador ou Gerente, nem a si mesma.
      // Equipe de treinamentos cria e desativa o acesso de funcionários ao portal do aluno.
      allow create: if tem(['admin'])
        || (tem(['gestao']) && !(request.resource.data.papel in ['admin', 'gerente']))
        || ((trein(['gestor', 'tst', 'rh']) || admi(['rh'])) && request.resource.data.papel == 'funcionario')
        || (logado() && request.auth.uid == uid && request.resource.data.papel == 'admin'
            && getAfter(/databases/$(database)/documents/config/setup).data.adminUid == uid);
      allow update: if tem(['admin'])
        || (tem(['gestao']) && request.auth.uid != uid
            && !(resource.data.papel in ['admin', 'gerente']) && !(request.resource.data.papel in ['admin', 'gerente']))
        || ((trein(['gestor', 'tst', 'rh']) || admi(['rh'])) && resource.data.papel == 'funcionario' && request.resource.data.papel == 'funcionario')
        || (logado() && request.auth.uid == uid && resource.data.papel == 'funcionario'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['trocarSenha', 'senhaTrocadaEm']));
      allow delete: if tem(['admin']);
    }
    // login do portal do aluno: matrícula → e-mail interno da conta
    match /login/{chave} { allow read: if true; allow write: if trein(['gestor', 'tst', 'rh']) || admi(['rh']); }

    // aprovações de exceção: só gerência
    match /decisoes/{id} { allow read: if equipe(); allow write: if tem(['admin', 'gerente']); }

    match /funcionarios/{id} {
      allow read: if equipe() || (aluno() && meuFunc() == id);
      allow write: if tem(['admin', 'gerente', 'gestao', 'almox', 'tst', 'rh']) || trein(['gestor', 'tst', 'rh']) || admi(['rh']);
    }
    match /trein_tipos/{id}  { allow read: if equipe(); allow write: if tem(['admin', 'gerente', 'gestao', 'tst', 'rh']) || trein(['gestor', 'tst', 'rh']); }
    match /treinamentos/{id} {
      allow read: if equipe() || (aluno() && resource.data.funcionarioId == meuFunc());
      allow write: if tem(['admin', 'gerente', 'gestao', 'tst', 'rh']) || trein(['gestor', 'tst', 'rh', 'instrutor']);
    }
    match /kits/{id}         { allow read: if equipe(); allow write: if tem(['admin', 'gerente', 'gestao', 'tst']); }

    match /ferramentas/{id}  { allow read: if equipe(); allow write: if tem(['admin', 'gerente', 'gestao', 'almox']); }
    match /cautelas/{id}     { allow read: if equipe(); allow write: if tem(['admin', 'gerente', 'gestao', 'almox']); }
    match /epis/{id}         { allow read: if equipe(); allow write: if tem(['admin', 'gerente', 'gestao', 'almox', 'tst']); }
    match /entregas/{id}     { allow read: if equipe(); allow write: if tem(['admin', 'gerente', 'gestao', 'almox', 'tst']); }
    match /autorizacoes/{id} { allow read: if equipe(); allow write: if tem(['admin', 'gerente', 'gestao', 'almox', 'tst']); }
    match /notas/{id}        { allow read: if equipe(); allow write: if tem(['admin', 'gerente', 'gestao', 'almox', 'tst']); }
    match /estoques/{id}     { allow read: if equipe(); allow write: if tem(['admin', 'gerente', 'gestao', 'almox']); }
    match /transferencias/{id} { allow read: if equipe(); allow write: if tem(['admin', 'gerente', 'gestao', 'almox']); }

    // ---------- módulo Treinamentos ----------
    match /areas/{id}     { allow read: if ativo(); allow write: if trein(['gestor', 'tst', 'rh']); }
    match /trein_ext/{id} {
      allow read: if equipe() || (aluno() && resource.data.funcionarioId == meuFunc());
      allow write: if trein(['gestor', 'tst', 'rh', 'instrutor']);
    }
    match /padroes/{id}   { allow read: if ativo(); allow write: if trein(['gestor', 'tst', 'rh', 'instrutor']); }
    match /padrao_reg/{id} {
      allow read: if equipe() || (aluno() && resource.data.funcionarioId == meuFunc());
      allow create: if trein(['gestor', 'tst', 'rh', 'instrutor'])
        || (aluno() && request.resource.data.funcionarioId == meuFunc() && request.resource.data.forma == 'ead');
      allow update, delete: if trein(['gestor', 'tst', 'rh']);
    }
    match /cursos/{id}    { allow read: if ativo(); allow write: if trein(['gestor', 'tst', 'rh', 'instrutor']); }
    match /matriculas/{id} {
      allow read: if equipe() || (aluno() && resource.data.funcionarioId == meuFunc());
      allow write: if trein(['gestor', 'tst', 'rh', 'instrutor']) || admi(['rh']);
      // o aluno só registra o próprio progresso: não marca prática, não emite certificado
      allow update: if aluno() && resource.data.funcionarioId == meuFunc()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['prog', 'tempo', 'inicioEm', 'concluidoEm']);
    }
    // ---------- módulo Alocação em OM ----------
    match /oms/{id}          { allow read: if aloc(['adm', 'consulta']); allow write: if aloc(['adm']); }
    match /om_fixa/{id}      { allow read: if aloc(['adm', 'consulta']); allow write: if aloc(['adm']); }
    match /alocacoes/{id}    { allow read: if aloc(['adm', 'consulta']); allow write: if aloc(['adm']); }
    match /apontamentos/{id} { allow read: if aloc(['adm', 'consulta']); allow write: if aloc(['adm']); }

    // ---------- módulo Admissão ----------
    // o candidato não faz login: abre o processo pelo código do link (não dá para listar) e só mexe no campo "cand"
    match /admissoes/{tk} {
      allow get: if admi(['rh', 'consulta']) || resource.data.status == 'aberto';
      allow list: if admi(['rh', 'consulta']);
      allow create, delete: if admi(['rh']);
      allow update: if admi(['rh'])
        || (resource.data.status == 'aberto' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cand']));
      // documentos em partes; o candidato grava enquanto o processo está aberto, só o RH lê
      match /p/{pid} {
        allow read: if admi(['rh', 'consulta']);
        allow create, update: if admi(['rh'])
          || (get(/databases/$(database)/documents/admissoes/$(tk)).data.status == 'aberto'
              && request.resource.data.keys().hasOnly(['d']) && request.resource.data.d is string && request.resource.data.d.size() < 760000);
        allow delete: if admi(['rh']);
      }
      // documentos para o candidato ler e assinar (carta-convite, termo LGPD, OS e termo de EPI): só o RH grava
      match /d/{pid} {
        allow get: if admi(['rh', 'consulta']) || get(/databases/$(database)/documents/admissoes/$(tk)).data.status == 'aberto';
        allow list: if admi(['rh', 'consulta']);
        allow write: if admi(['rh']);
      }
    }
    // salário: só o RH
    match /admissoes_priv/{tk} { allow read, write: if admi(['rh']); }

    // anexos (PDFs de padrões, listas, certificados externos, materiais dos cursos), guardados em partes
    // o aluno abre um arquivo pelo código (vem do padrão ou do curso), mas não lista os arquivos
    match /arquivos/{id} {
      allow get: if ativo();
      allow list: if equipe();
      allow write: if trein(['gestor', 'tst', 'rh', 'instrutor']);
      match /p/{n} { allow get: if ativo(); allow list: if equipe(); allow write: if trein(['gestor', 'tst', 'rh', 'instrutor']); }
    }
  }
}
